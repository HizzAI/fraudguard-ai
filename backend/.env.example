# ─────────────────────────────────────────────────────────────────────────────
# FraudGuardAI backend — environment variable template
#
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file that contains real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── AndroZoo dataset ingestion ───────────────────────────────────────────────
# Obtain your API key from: https://androzoo.uni.lu/access
# Set this variable in your shell or in a local .env file (NOT committed).
ANDROZOO_API_KEY=<your-androzoo-api-key-here>

# ── Backend server (existing) ─────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# ── CORS configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For production (e.g., Vercel), set this to your frontend URL.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
