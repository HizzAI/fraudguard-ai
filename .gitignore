# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
build/
.eggs/

# ─── Virtual environments ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.venv/
venv/
env/

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Never commit .env files with real secrets.
# Use .env.example for templates.
# AndroZoo API key must NEVER appear in source control.
.env.androzoo
.env.secrets
secrets.env

# ─── Uploaded APKs ────────────────────────────────────────────────────────────
# User-uploaded files are transient; don't commit them.
backend/uploads/
# Scratch/test APKs at project root or backend root
*.apk
# IMPORTANT: data/raw/ APKs ARE committed intentionally (prototype dataset).
# To exclude them, uncomment the line below:
# data/raw/

# ─── AndroZoo dataset ─────────────────────────────────────────────────────────
# AndroZoo-downloaded APKs are NEVER committed to source control.
# They may be large and are re-downloadable via the AndroZoo API.
data/raw/androzoo/*.apk
# AndroZoo bulk metadata file is also never committed (can be hundreds of MB).
data/raw/androzoo/latest.csv
data/raw/androzoo/latest.csv.gz
# The manifest CSV (data/manifests/) IS committed — it contains only safe metadata.
# The processed/ directory holds derived features; commit selectively.
data/processed/*.apk

# ─── ML model artifacts ───────────────────────────────────────────────────────
# Trained model files should NOT be committed to source control.
# They should be reproduced via the training script.
*.pkl
!backend/app/ml/model_rf_v1.pkl
*.joblib
*.model

# ─── Backend scratch / one-off scripts ────────────────────────────────────────
backend/test.txt
backend/check_methods.py
backend/test_androguard*.py
backend/dummy.apk
backend/sample.apk

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
uvicorn.log

# ─── Pytest cache ─────────────────────────────────────────────────────────────
.pytest_cache/
.cache/

# ─── Coverage ─────────────────────────────────────────────────────────────────
.coverage
htmlcov/
coverage.xml

# ─── Node / Vite ──────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ─── IDEs / Editors ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn

# ─── Temporary / OS artifacts ─────────────────────────────────────────────────
*.tmp
*.bak
*.orig
Thumbs.db
